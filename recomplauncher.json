{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Hookshot",
  "repo": "notquiteog/Hookshot",
  "min": "0.90.0-beta.36",
  "inputs": [
    {
      "id": "oot",
      "label": "Your copy of The Legend of Zelda: Ocarina of Time for Nintendo Switch 2, version 131072 (build e0f3ccfa): the .nup file, or the folder that holds its romfs and exefs.",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        },
        {
          "type": "folder"
        }
      ]
    },
    {
      "id": "dkb",
      "label": "Your copy of Donkey Kong Bananza for Nintendo Switch 2, 3.2.0 (build e25c90c1): the .nup file, or the folder that holds its romfs and exefs.",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        },
        {
          "type": "folder"
        }
      ]
    },
    {
      "id": "mkw",
      "label": "Your copy of Mario Kart World for Nintendo Switch 2, 1.0.0 (build 9e244438): the .nup file, or the folder that holds its romfs and exefs.",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nup"
          ]
        },
        {
          "type": "folder"
        }
      ]
    }
  ],
  "start": {
    "program": [
      "Hookshot.AppImage",
      "HookshotBuilder.exe"
    ],
    "args": [
      "--play",
      "{home}/Games/Hookshot"
    ]
  },
  "prepare": {
    "program": [
      "Hookshot.AppImage",
      "HookshotBuilder.exe"
    ],
    "args": [
      "--cli",
      "--prepare",
      "--game-oot={input:oot}",
      "--game-dkb={input:dkb}",
      "--game-mkw={input:mkw}"
    ],
    "label": "Building the game from your copy (10 to 45 minutes)",
    "timeout": 7200,
    "options": [
      {
        "id": "dlss",
        "label": "NVIDIA DLSS: download NVIDIA's DLSS files and accept their license",
        "note": "NVIDIA's, not Hookshot's: the build downloads them from NVIDIA and puts DLSS in each game folder.",
        "args": [
          "--dlss",
          "--accept-nvidia-license"
        ],
        "os": [
          "windows"
        ],
        "gpu": "nvidia",
        "license": {
          "name": "NVIDIA RTX SDKs license (NVIDIA DLSS)",
          "url": "https://github.com/NVIDIA/DLSS/blob/9981c6350dc58c0ce21f024fd65e31e851c31689/LICENSE.txt"
        }
      }
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{home}/Games/Hookshot/hookshot_options.ini"
        }
      ]
    }
  ],
  "saves": [
    "{local}/hookshot",
    "{home}/Games/Hookshot/user"
  ],
  "folders": {
    "saves": [
      {
        "path": "{home}/Games/Hookshot/user",
        "if": "{home}/Games/Hookshot/user"
      },
      {
        "path": "{local}/hookshot"
      }
    ],
    "game": [
      {
        "path": "{home}/Games/Hookshot"
      }
    ]
  },
  "settings": [
    {
      "id": "preset",
      "label": "Quality preset",
      "help": "Sets resolution, upscaling, frame generation and the video memory limits for a card with that much memory. Changing most other rows yourself sets it back to Custom.",
      "choices": [
        {
          "label": "Custom",
          "set": {
            "quality_preset": "0"
          }
        },
        {
          "label": "Minimum (4 GB)",
          "set": {
            "quality_preset": "1"
          }
        },
        {
          "label": "Low (6 GB)",
          "set": {
            "quality_preset": "2"
          }
        },
        {
          "label": "Balanced (8 GB)",
          "set": {
            "quality_preset": "3"
          }
        },
        {
          "label": "High (12 GB)",
          "set": {
            "quality_preset": "4"
          }
        },
        {
          "label": "Ultra (16 GB+)",
          "set": {
            "quality_preset": "5"
          }
        }
      ],
      "defaults": {
        "quality_preset": "0"
      }
    },
    {
      "id": "ultrawide",
      "label": "Aspect ratio",
      "help": "The picture's shape: your monitor's (the default: wider on an ultrawide, narrower on 4:3 or 16:10), or the game's 16:9. Applies after a restart.",
      "choices": [
        {
          "label": "16:9",
          "set": {
            "ultrawide": "0"
          }
        },
        {
          "label": "Monitor's shape",
          "set": {
            "ultrawide": "1"
          }
        }
      ],
      "defaults": {
        "ultrawide": "1"
      }
    },
    {
      "id": "output",
      "label": "Output resolution",
      "help": "The size of the game's whole frame before it is scaled to your window. Applies after a restart.",
      "choices": [
        {
          "label": "2048x1152",
          "set": {
            "output_res": "2048x1152"
          }
        },
        {
          "label": "2560x1440",
          "set": {
            "output_res": "2560x1440"
          }
        },
        {
          "label": "3840x2160",
          "set": {
            "output_res": "3840x2160"
          }
        }
      ],
      "defaults": {
        "output_res": "2048x1152"
      }
    },
    {
      "id": "handheld",
      "label": "Profile",
      "help": "Runs the game as the console docked or handheld. Handheld is a lower resolution, lighter on the graphics card. Applies after a restart.",
      "choices": [
        {
          "label": "Docked",
          "set": {
            "handheld_profile": "0"
          }
        },
        {
          "label": "Handheld",
          "set": {
            "handheld_profile": "1"
          }
        }
      ],
      "defaults": {
        "handheld_profile": "0"
      }
    },
    {
      "id": "resolution",
      "label": "Render resolution",
      "help": "How sharp the 3D is drawn. Auto lets the game lower it when the graphics card is busy.",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "resolution": "0"
          }
        },
        {
          "label": "100%",
          "set": {
            "resolution": "1"
          }
        },
        {
          "label": "75%",
          "set": {
            "resolution": "2"
          }
        },
        {
          "label": "67%",
          "set": {
            "resolution": "3"
          }
        },
        {
          "label": "50%",
          "set": {
            "resolution": "4"
          }
        }
      ],
      "defaults": {
        "resolution": "0"
      }
    },
    {
      "id": "sharpness",
      "label": "Sharpness",
      "help": "Sharpens the picture on its way to the window. Too much shows halos around edges.",
      "choices": [
        {
          "label": "0%",
          "set": {
            "sharpness": "0"
          }
        },
        {
          "label": "30%",
          "set": {
            "sharpness": "30"
          }
        },
        {
          "label": "60%",
          "set": {
            "sharpness": "60"
          }
        },
        {
          "label": "100%",
          "set": {
            "sharpness": "100"
          }
        }
      ],
      "defaults": {
        "sharpness": "0"
      }
    },
    {
      "id": "framegen",
      "label": "Frame generation",
      "help": "Makes extra frames between the game's own for smoother motion. It adds a little input delay, and fast motion can show artifacts.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "frame_generation": "0"
          }
        },
        {
          "label": "2x",
          "set": {
            "frame_generation": "2"
          }
        },
        {
          "label": "3x",
          "set": {
            "frame_generation": "3"
          }
        },
        {
          "label": "4x",
          "set": {
            "frame_generation": "4"
          }
        },
        {
          "label": "6x",
          "set": {
            "frame_generation": "6"
          }
        },
        {
          "label": "8x",
          "set": {
            "frame_generation": "8"
          }
        }
      ],
      "defaults": {
        "frame_generation": "0"
      }
    },
    {
      "id": "pacing",
      "label": "Frame pacing",
      "help": "Shows each frame at an even interval. Less stutter, at up to one frame of delay.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "frame_pacing": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "frame_pacing": "1"
          }
        }
      ],
      "defaults": {
        "frame_pacing": "0"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "help": "Fills the screen with the game, without the window's border.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "upscaling",
      "label": "Window scaling filter",
      "help": "The filter that scales the picture to your window. Lanczos is the sharpest.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "upscaling": "0"
          }
        },
        {
          "label": "Catmull-Rom",
          "set": {
            "upscaling": "1"
          }
        },
        {
          "label": "Lanczos",
          "set": {
            "upscaling": "2"
          }
        }
      ],
      "defaults": {
        "upscaling": "0"
      }
    },
    {
      "id": "speed",
      "label": "Game speed",
      "help": "Per frame slows the game down whenever it runs below 60 fps. Real time keeps normal speed down to 15 fps.",
      "choices": [
        {
          "label": "Per frame",
          "set": {
            "game_speed": "0"
          }
        },
        {
          "label": "Real time",
          "set": {
            "game_speed": "1"
          }
        }
      ],
      "defaults": {
        "game_speed": "1"
      }
    },
    {
      "id": "text",
      "label": "Text speed",
      "help": "How fast dialogue appears. Instant shows each page at once.",
      "choices": [
        {
          "label": "Normal",
          "set": {
            "text_speed": "0"
          }
        },
        {
          "label": "2x",
          "set": {
            "text_speed": "1"
          }
        },
        {
          "label": "4x",
          "set": {
            "text_speed": "2"
          }
        },
        {
          "label": "Instant",
          "set": {
            "text_speed": "3"
          }
        }
      ],
      "defaults": {
        "text_speed": "0"
      }
    },
    {
      "id": "fps",
      "label": "FPS counter",
      "help": "Shows frames per second in the top right corner.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fps_counter": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fps_counter": "1"
          }
        }
      ],
      "defaults": {
        "fps_counter": "0"
      }
    },
    {
      "id": "background",
      "label": "Controller in background",
      "help": "Keeps the controller working while another window has the focus.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "controller_in_background": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "controller_in_background": "1"
          }
        }
      ],
      "defaults": {
        "controller_in_background": "0"
      }
    },
    {
      "id": "mousecam",
      "label": "Mouse camera",
      "help": "Native turns the camera with the mouse one to one. As the stick uses the mouse in place of the right stick.",
      "choices": [
        {
          "label": "As the stick",
          "set": {
            "mouse_camera": "0"
          }
        },
        {
          "label": "Native",
          "set": {
            "mouse_camera": "1"
          }
        }
      ],
      "defaults": {
        "mouse_camera": "0"
      }
    },
    {
      "id": "compile_shaders",
      "label": "Compile shaders",
      "help": "All (the default): every shader, the pipelines the game is known to use and the predicted ones. Most: without the predicted pipelines, 20-30% shorter (19% on an RTX 5060 Ti, 30% on an RTX 3090); on one route it cost nothing in play, but more may be compiled the first time you visit a place. Applies at the next build, update or preparation.",
      "choices": [
        {
          "label": "All",
          "set": {
            "compile_shaders": "1"
          }
        },
        {
          "label": "Most",
          "set": {
            "compile_shaders": "0"
          }
        }
      ],
      "defaults": {
        "compile_shaders": "1"
      }
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Where your saves are kept.",
      "open": "saves"
    },
    {
      "id": "game",
      "label": "Game folder",
      "help": "The built game, with its log and mods folder.",
      "open": "game"
    }
  ],
  "games": [
    {
      "id": "oot",
      "name": "The Legend of Zelda: Ocarina of Time",
      "args": [
        "--game",
        "oot"
      ],
      "inputs": [
        "oot"
      ],
      "saves": [
        "{local}/hookshot",
        "{home}/Games/Hookshot/user"
      ]
    },
    {
      "id": "dkb",
      "name": "Donkey Kong Bananza",
      "args": [
        "--game",
        "dkb"
      ],
      "inputs": [
        "dkb"
      ],
      "saves": [
        "{local}/hookshot-dkb",
        "{home}/Games/Hookshot-dkb/user"
      ]
    },
    {
      "id": "mkw",
      "name": "Mario Kart World",
      "args": [
        "--game",
        "mkw"
      ],
      "inputs": [
        "mkw"
      ],
      "saves": [
        "{local}/hookshot-mkw",
        "{home}/Games/Hookshot-mkw/user"
      ]
    }
  ]
}
