#version 450
// the frame to the window's size (the Insert menu's Upscaling, Sharpness): Catmull-Rom or Lanczos 2, or the linear filter, then
// a contrast-adaptive sharpen (RCAS-style, build 6) that cannot go past the light around the pixel, so it adds no halos
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { int mode; float sharp; } pc;
const float PI = 3.14159265;
float lanczos2(float x) {
    x = abs(x);
    if (x < 1e-4) return 1.0;
    if (x >= 2.0) return 0.0;
    const float p = PI * x;
    return 2.0 * sin(p) * sin(p * 0.5) / (p * p);
}
float catmull(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}
vec3 filtered(vec2 uv) {
    if (pc.mode == 0) return textureLod(src, uv, 0.0).rgb;
    const vec2 size = vec2(textureSize(src, 0));
    const vec2 p = uv * size - 0.5;
    const ivec2 b = ivec2(floor(p));
    const vec2 f = p - vec2(b);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -1; y <= 2; y++)
        for (int x = -1; x <= 2; x++) {
            const vec2 d = vec2(x, y) - f;
            const float w = pc.mode == 2 ? lanczos2(d.x) * lanczos2(d.y) : catmull(d.x) * catmull(d.y);
            sum += w * texelFetch(src, clamp(b + ivec2(x, y), ivec2(0), ivec2(size) - 1), 0).rgb;
            weight += w;
        }
    return sum / weight;
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const vec2 uv = (vec2(g) + 0.5) / vec2(d);
    vec3 c = filtered(uv);
    if (pc.sharp > 0.0) {
        // (hookshot DLSS build 6) A contrast-adaptive sharpen in the manner of AMD FidelityFX RCAS: its four neighbours one
        // source pixel away (the old sharpen took them one window pixel away, under a source pixel when the window is
        // larger, and clamped to their range: next to no change at any setting). The lobe is limited per pixel so that
        // nothing goes past the light around it (no halos, no clipping); pc.sharp 1 is RCAS's strongest.
        const vec2 e = 1.0 / vec2(textureSize(src, 0));
        const vec3 n = textureLod(src, uv + vec2(0.0, -e.y), 0.0).rgb, s = textureLod(src, uv + vec2(0.0, e.y), 0.0).rgb;
        const vec3 w = textureLod(src, uv + vec2(-e.x, 0.0), 0.0).rgb, r = textureLod(src, uv + vec2(e.x, 0.0), 0.0).rgb;
        const vec3 mn4 = min(min(n, s), min(w, r)), mx4 = max(max(n, s), max(w, r));
        const vec3 hit_min = min(mn4, c) / max(4.0 * max(mx4, c), vec3(1e-5));
        const vec3 hit_max = (1.0 - max(mx4, c)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
        const vec3 lobe3 = max(-hit_min, hit_max);
        const float lobe = max(-0.1875, min(max(max(lobe3.r, lobe3.g), lobe3.b), 0.0)) * clamp(pc.sharp, 0.0, 1.0);
        c = clamp((lobe * (n + s + w + r) + c) / (4.0 * lobe + 1.0), 0.0, 1.0);
    }
    imageStore(dst, g, vec4(c, 1.0));
}
