#version 450
// AMD FidelityFX Super Resolution 1.0 (FSR 1), the Insert menu's Upscaling "FSR 1": the frame to the window's size.
// pc.pass 0: EASU (edge-adaptive spatial upsampling), the source to an image of the window's size.
// pc.pass 1: RCAS (robust contrast-adaptive sharpening) of that image, pc.sharp the sharpness as FSR takes it
// (exp2(-stops): 1.0 strongest), into the destination.
// A port of ffx_fsr1.h's FsrEasuF and FsrRcasF (float path, RCAS denoise on), reading texels with texelFetch.
// FidelityFX FSR 1 is Copyright (c) 2021 Advanced Micro Devices, Inc., MIT license:
// Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation
// files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy,
// modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the
// Software is furnished to do so, subject to the following conditions: The above copyright notice and this permission notice
// shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY
// OF ANY KIND, EXPRESS OR IMPLIED.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { int pass; float sharp; } pc;

ivec2 src_max;
vec3 tap(ivec2 p) { return texelFetch(src, clamp(p, ivec2(0), src_max), 0).rgb; }
float luma(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }   // (FSR's: twice the green, half red and blue)

// ---- EASU ----
void easu_set(inout vec2 dir, inout float len, vec2 pp, float w, float lA, float lB, float lC, float lD, float lE) {
    // lA up, lB left, lC centre, lD right, lE down; w the bilinear weight of this corner
    const float dc = lD - lC, cb = lC - lB;
    float lenX = max(abs(dc), abs(cb));
    lenX = 1.0 / max(lenX, 1.0 / 65536.0);
    const float dirX = lD - lB;
    dir.x += dirX * w;
    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
    lenX *= lenX;
    len += lenX * w;
    const float ec = lE - lC, ca = lC - lA;
    float lenY = max(abs(ec), abs(ca));
    lenY = 1.0 / max(lenY, 1.0 / 65536.0);
    const float dirY = lE - lA;
    dir.y += dirY * w;
    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
    lenY *= lenY;
    len += lenY * w;
}
void easu_tap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
    vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * -dir.y + off.y * dir.x);
    v *= len;
    float d2 = min(v.x * v.x + v.y * v.y, clp);
    float wB = 2.0 / 5.0 * d2 - 1.0;
    float wA = lob * d2 - 1.0;
    wB *= wB;
    wA *= wA;
    wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
    const float w = wB * wA;
    aC += c * w;
    aW += w;
}
vec3 easu(ivec2 ip, vec2 scale) {
    vec2 pp = (vec2(ip) + 0.5) * scale - 0.5;
    const vec2 fp = floor(pp);
    pp -= fp;
    const ivec2 f0 = ivec2(fp);
    //    b c
    //  e f g h
    //  i j k l
    //    n o
    const vec3 bC = tap(f0 + ivec2(0, -1)), cC = tap(f0 + ivec2(1, -1));
    const vec3 eC = tap(f0 + ivec2(-1, 0)), fC = tap(f0), gC = tap(f0 + ivec2(1, 0)), hC = tap(f0 + ivec2(2, 0));
    const vec3 iC = tap(f0 + ivec2(-1, 1)), jC = tap(f0 + ivec2(0, 1)), kC = tap(f0 + ivec2(1, 1)), lC = tap(f0 + ivec2(2, 1));
    const vec3 nC = tap(f0 + ivec2(0, 2)), oC = tap(f0 + ivec2(1, 2));
    const float bL = luma(bC), cL = luma(cC), eL = luma(eC), fL = luma(fC), gL = luma(gC), hL = luma(hC);
    const float iL = luma(iC), jL = luma(jC), kL = luma(kC), lL = luma(lC), nL = luma(nC), oL = luma(oC);
    vec2 dir = vec2(0.0);
    float len = 0.0;
    easu_set(dir, len, pp, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
    easu_set(dir, len, pp, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
    easu_set(dir, len, pp, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
    easu_set(dir, len, pp, pp.x * pp.y, gL, jL, kL, lL, oL);
    const vec2 dir2 = dir * dir;
    float dirR = dir2.x + dir2.y;
    const bool zro = dirR < 1.0 / 32768.0;
    dirR = zro ? 1.0 : inversesqrt(dirR);
    dir.x = zro ? 1.0 : dir.x;
    dir *= dirR;
    len = len * 0.5;
    len *= len;
    const float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
    const vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
    const float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
    const float clp = 1.0 / lob;
    const vec3 min4 = min(min(fC, gC), min(jC, kC)), max4 = max(max(fC, gC), max(jC, kC));
    vec3 aC = vec3(0.0);
    float aW = 0.0;
    easu_tap(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, bC);
    easu_tap(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, cC);
    easu_tap(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, iC);
    easu_tap(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, jC);
    easu_tap(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, fC);
    easu_tap(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, eC);
    easu_tap(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, kC);
    easu_tap(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, lC);
    easu_tap(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, hC);
    easu_tap(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, gC);
    easu_tap(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, oC);
    easu_tap(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, nC);
    return min(max4, max(min4, aC / max(aW, 1e-6)));
}

// ---- RCAS ----
const float RCAS_LIMIT = 0.25 - (1.0 / 16.0);
vec3 rcas(ivec2 sp) {
    //    b
    //  d e f
    //    h
    const vec3 b = tap(sp + ivec2(0, -1)), d = tap(sp + ivec2(-1, 0)), e = tap(sp), f = tap(sp + ivec2(1, 0)),
               h = tap(sp + ivec2(0, 1));
    const float bL = luma(b), dL = luma(d), eL = luma(e), fL = luma(f), hL = luma(h);
    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
    const float range = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = clamp(abs(nz) / max(range, 1.0 / 65536.0), 0.0, 1.0);
    nz = -0.5 * nz + 1.0;
    const vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
    const vec2 peakC = vec2(1.0, -4.0);
    const vec3 hitMin = mn4 / max(4.0 * mx4, vec3(1.0 / 65536.0));
    const vec3 hitMax = (peakC.x - mx4) / min(4.0 * mn4 + peakC.y, vec3(-1.0 / 65536.0));
    const vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-RCAS_LIMIT, min(max(max(lobeRGB.r, lobeRGB.g), lobeRGB.b), 0.0)) * pc.sharp;
    lobe *= nz;
    const float rcpL = 1.0 / (4.0 * lobe + 1.0);
    return clamp((lobe * b + lobe * d + lobe * h + lobe * f + e) * rcpL, 0.0, 1.0);
}

void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const ivec2 s = textureSize(src, 0);
    src_max = s - 1;
    const vec3 c = pc.pass == 0 ? easu(g, vec2(s) / vec2(d)) : rcas(g);
    imageStore(dst, g, vec4(c, 1.0));
}
